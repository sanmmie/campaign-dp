# Required Environment Variables
# Copy to .env and fill in values

# Node environment
NODE_ENV=production

# Server port (local dev only)
PORT=3001

# Database (PostgreSQL) - required
DATABASE_URL=postgresql://user:password@host:5432/deltadp

# Supabase (auth + storage) - required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage
STORAGE_BUCKET=campaign-assets
STORAGE_REGION=us-east-1

# Auth
JWT_SECRET=your-32-character-minimum-secret-here
ADMIN_EMAILS=admin@example.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=40000000

# Campaign pack
CAMPAIGN_PACK_ID=renewed-hope-2027
CAMPAIGN_AUTHORIZED_BY=
CAMPAIGN_DISCLAIMER=User-generated campaign material. Not an official communication.

# Frontend URL (CORS)
FRONTEND_URL=https://campaign-dp.vercel.app

# Optional Redis for rate limiting
# REDIS_URL=redis://host:6379