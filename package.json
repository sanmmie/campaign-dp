{
  "name": "deltadp-campaign-edition",
  "version": "1.0.0",
  "description": "DeltaDP Campaign Edition - Renewed Hope 2027",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run build --workspace=shared && concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:vercel": "npm run build:frontend && npm run build:backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace=shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace=shared && npm run test --workspaces --if-present",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:seed:prod": "npm run db:seed:prod --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true,
    "prisma@5.22.0": true
  }
}
