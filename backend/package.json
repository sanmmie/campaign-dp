{
  "name": "@deltadp/backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "npm run build --prefix ../shared && tsx watch src/server.ts",
    "dev:vercel": "npm run build --prefix ../shared && tsx watch src/server.ts",
    "build": "npm run build --prefix ../shared && prisma generate && tsc",
    "build:vercel": "npm run build --prefix ../shared && prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "npm run build --prefix ../shared && prisma generate && tsc --noEmit",
    "test": "npm run build --prefix ../shared && vitest run",
    "db:push": "tsx src/db/push.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@deltadp/shared": "^1.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.9.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.0",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "sharp": "^0.33.2",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "prisma": "^5.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
