  "version": 2,
  "buildCommand": "npm run build:vercel",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "main": "dist/vercel.js",
  "framework": null,
  "functions": {
    "dist/vercel.js": {
      "maxDuration": 30
    }
  }
}