generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CampaignPack {
  id                String   @id @default(cuid())
  name              String
  authorizedBy      String?
  authorizationRef  String?
  disclaimer        String
  brandPrimary      String
  brandSecondary    String
  brandAccent       String
  brandLockupId     String?  @unique
  defaultHeadline   String
  defaultSubhead    String
  shareTargets      String   // JSON array
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assets            PackAsset[]
  templates         Template[]
  lockup            PackAsset? @relation("PackLockup", fields: [brandLockupId], references: [id])

  // Organization/campaign ownership (nullable to preserve existing data)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])

  @@index([authorizedBy])
  @@index([organizationId])
  @@index([campaignId])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("supporter") // supporter, candidate, campaign_pro, state, national
  status      String   @default("active")   // active, suspended, cancelled
  ownerId     String?
  settings    String   @default("{}")      // JSON (white-label: customDomain, contactEmail, appName, supportEmail)

  // Configurable organization branding
  brandPrimary    String?
  brandSecondary  String?
  brandAccent     String?
  brandLockupId   String?
  defaultHeadline String?
  defaultSubhead  String?

  // Nigerian organizational structure (state / LGA / ward)
  state String?
  lga   String?
  ward  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]
  memberships Membership[]
  packs       CampaignPack[]
  templates   Template[]
  projects    Project[]
  generations GenerationRecord[]
  subscription Subscription?
  paymentTransactions PaymentTransaction[]
  brandLockup   PackAsset? @relation("OrgBrandLockup", fields: [brandLockupId], references: [id])

  @@index([slug])
  @@index([ownerId])
  @@index([state])
}

model Campaign {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  slug              String   @unique
  status            String   @default("draft") // draft, active, completed, archived
  authorizedBy      String?
  authorizationRef  String?
  disclaimer        String
  brandPrimary      String?
  brandSecondary    String?
  brandAccent       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  packs             CampaignPack[]
  templates         Template[]
  projects          Project[]
  generations       GenerationRecord[]

  @@index([organizationId])
  @@index([slug])
  @@index([status])
}

model Membership {
  id            String   @id @default(cuid())
  userId        String
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role          String   @default("analyst") // platform_admin, org_admin, campaign_manager, template_designer, analyst
  createdAt     DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Subscription {
  id                   String   @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 String   // supporter, candidate, campaign_pro, state, national
  status               String   @default("active") // active, past_due, canceled, incomplete
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId])
  @@unique([organizationId])
}

model PackAsset {
  id          String       @id @default(cuid())
  packId      String
  pack        CampaignPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  usedAsLockupIn CampaignPack? @relation("PackLockup")
  type        String
  url         String
  width       Int?
  height      Int?
  mimeType    String
  uploadedBy  String
  uploadedAt  DateTime     @default(now())

  // Referenced as an organization brand lockup
  organizationBrandLockup Organization[] @relation("OrgBrandLockup")

  @@index([packId])
}

model Template {
  id          String           @id @default(cuid())
  name        String
  category    String
  latestVersion Int            @default(1)
  packId      String
  pack        CampaignPack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Organization/campaign ownership (nullable to preserve existing data)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])

  versions    TemplateVersion[]

  @@index([packId])
  @@index([category])
  @@index([organizationId])
  @@index([campaignId])
}

model TemplateVersion {
  id            String      @id @default(cuid())
  templateId    String
  template      Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version       Int
  name          String
  category      String
  canvasWidth   Int
  canvasHeight  Int
  photoZoneX    Float
  photoZoneY    Float
  photoZoneWidth Float
  photoZoneHeight Float
  photoZoneShape String
  photoZoneBorderRadius Float?
  photoZoneLocked Boolean  @default(false)
  layersJson    String
  isPublished   Boolean     @default(false)
  publishedAt   DateTime?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([templateId, version])
  @@index([templateId])
  @@index([isPublished])
}

model Project {
  id                String   @id @default(cuid())
  userId            String?
  packId            String
  templateId        String
  templateVersion   Int
  templateSnapshot  String
  photoUrl          String?
  photoTransform    String?
  textValues        String   @default("{}")
  editorState       String   @default("{}")
  exportSettings    String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Organization/campaign ownership (nullable to preserve existing data)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([packId])
  @@index([templateId])
  @@index([organizationId])
  @@index([campaignId])
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  email             String   @unique
  displayName       String?
  avatarUrl         String?
  defaultName       String?
  defaultTitle      String?
  defaultOrganisation String?
  defaultWardLGA    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GenerationRecord {
  id          String   @id @default(cuid())
  projectId   String
  storagePath String?
  userId      String?
  presetId    String
  format      String
  fileSize    BigInt
  width       Int
  height      Int
  createdAt   DateTime @default(now())

  // Organization/campaign ownership (nullable to preserve existing data)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@index([organizationId])
  @@index([campaignId])
}

model AbuseReport {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  reporterId  String?
  reason      String
  details     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

model FontDefinition {
  id              String   @id @default(cuid())
  name            String
  family          String
  weights         String   // JSON array
  url             String
  unicodeRanges   String   // JSON array
  supportsYoruba  Boolean  @default(false)
  variable        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  properties String
  timestamp DateTime @default(now())
  userId    String?
  sessionId String

  @@index([event])
  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int      // 1 (poor) to 5 (excellent)
  category  String   @default("other") // bug, idea, usability, other
  message   String
  contact   String?  // optional, only when the person chooses to provide it
  consent   Boolean  @default(false) // explicit consent to store the feedback
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
  @@index([userId])
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference       String   @unique
  paystackReference String?
  amount          Int      // Amount in kobo (smallest currency unit)
  currency        String   @default("NGN")
  status          String   // pending, success, failed, abandoned
  plan            String   // supporter, candidate, campaign_pro, state, national
  interval        String   // monthly, yearly
  paidAt          DateTime?
  gatewayResponse String?
  receiptNumber   String?
  customerEmail   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([reference])
  @@index([status])
  @@index([plan])
}